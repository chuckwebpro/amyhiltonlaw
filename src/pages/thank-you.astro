---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import SiteButton from '../components/site/SiteButton.astro';
import { site } from '../config/site';
import '../styles/hfl-status.css';

const heroImage = '/images/int-banner/interior_banner.webp';
---

<InteriorLayout
  title="Thank You"
  description="Hilton Family Law has received your message."
  noindex
  heroTitle="Thank You"
  heroImage={heroImage}
  heroAlt="Hilton Family Law"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Thank You', href: '/thank-you/' },
  ]}
  contentClass="status-page"
>
  <h2>Your message has been received</h2>
  <p>
    Thank you for contacting Hilton Family Law. We will reply as soon as we can. If your matter is
    urgent, please call the office at <a
      class="status-page__phone"
      href={`tel:${site.business.phoneHref}`}>{site.business.phone}</a
    >.
  </p>
  <div class="status-page__actions">
    <SiteButton href="/">Back to Home</SiteButton>
    <SiteButton href="/contact/">Contact</SiteButton>
  </div>
</InteriorLayout>
