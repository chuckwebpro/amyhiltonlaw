---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import EndorsementList from '../../components/site/EndorsementList.astro';
import { getLegacySeo, normalizeLegacyOgImage } from '../../lib/legacySeo';
import { site } from '../../config/site';

const sitePath = '/endorsements/';
const legacy = getLegacySeo(sitePath);
const heroImage = '/images/int-banner/int_endorse.webp';
---

<InteriorLayout
  title={legacy?.title}
  titleExact={Boolean(legacy?.title)}
  description={legacy?.description}
  image={normalizeLegacyOgImage(legacy?.ogImage, site.url)}
  heroTitle={legacy?.h1 ?? 'Endorsements'}
  heroImage={heroImage}
  heroAlt="Endorsements for Hilton Family Law"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Endorsements', href: sitePath },
  ]}
  contentClass="endorsements-page"
>
  <EndorsementList />
</InteriorLayout>
