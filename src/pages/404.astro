---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import SiteButton from '../components/site/SiteButton.astro';
import { site } from '../config/site';
import '../styles/hfl-status.css';

const heroImage = '/images/int-banner/interior_banner.webp';

const helpfulLinks = [
  { label: 'Home', href: '/' },
  { label: 'News', href: '/news/' },
  { label: 'Endorsements', href: '/endorsements/' },
  { label: 'Contact', href: '/contact/' },
];
---

<InteriorLayout
  title="Page Not Found"
  description="The page you requested is not available on Hilton Family Law."
  noindex
  heroTitle="Page Not Found"
  heroImage={heroImage}
  heroAlt="Hilton Family Law"
  contentClass="status-page"
>
  <h2>We couldn&rsquo;t find that page</h2>
  <p>
    The link may be out of date, or the page may have moved. Please try one of these pages, or call
    the office at <a class="status-page__phone" href={`tel:${site.business.phoneHref}`}
      >{site.business.phone}</a
    >.
  </p>
  <ul class="status-page__links">
    {
      helpfulLinks.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <div class="status-page__actions">
    <SiteButton href="/">Back to Home</SiteButton>
  </div>
</InteriorLayout>
