---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeQuoteHero from '../components/site/home/HomeQuoteHero.astro';
import HomeAwardBand from '../components/site/home/HomeAwardBand.astro';
import HomeServiceCards from '../components/site/home/HomeServiceCards.astro';
import HomeStormCta from '../components/site/home/HomeStormCta.astro';
import { getLegacySeo, normalizeLegacyOgImage } from '../lib/legacySeo';
import { site } from '../config/site';

const legacy = getLegacySeo('/');
const title =
  legacy?.title ?? 'Hilton Family Law, Antioch Attorney. Let Us Guide You Through This Storm';
const description =
  legacy?.description ??
  'Home - Amy’s family law practice philosophy is to help families transition with dignity. With her extensive trial background and dedication, clients are always pleased with the service she provides.';
const image = normalizeLegacyOgImage(legacy?.ogImage) ?? site.defaultOgImage;
---

<HomeLayout title={title} titleExact description={description} image={image}>
  <HomeQuoteHero />
  <HomeAwardBand />
  <HomeServiceCards />
  <HomeStormCta />
</HomeLayout>
