---
/**
 * Hilton content width — legacy `.contained` breakpoints (see hfl-contained.css).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  as?: 'div' | 'header' | 'footer' | 'nav' | 'section';
  class?: string;
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['contained', className]} {...rest}>
  <slot />
</Tag>
