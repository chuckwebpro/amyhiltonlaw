---
import type { ArticleEntry } from '../../lib/articles';
import { articleAuthor, articleDateFormat, getArticleCardImages } from '../../lib/articleCard';
import { newsCategorySlug } from '../../data/news-categories';
import PostCategoryPill from './PostCategoryPill.astro';

interface Props {
  entry: ArticleEntry;
  /** Larger cards in the “Most Recent Posts” row. */
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const href = `/article/${entry.id}/`;
const { src: image, fallbacks: imageFallbacks } = getArticleCardImages(entry);
const categorySlug = newsCategorySlug(entry.data.category);
---

<article
  class:list={['post-card group flex h-full flex-col', featured && 'post-card--featured']}
  data-post-card
  data-category={categorySlug}
  data-title={entry.data.title.toLowerCase()}
  data-description={entry.data.description.toLowerCase()}
>
  <div class="post-card-media relative">
    <a href={href} class="block overflow-hidden no-underline" tabindex="-1" aria-hidden="true">
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        data-fallbacks={JSON.stringify(imageFallbacks)}
        onerror="var f=JSON.parse(this.dataset.fallbacks||'[]');var i=+(this.dataset.fallbackIndex||0);if(i<f.length){this.dataset.fallbackIndex=String(i+1);this.src=f[i];}else{this.onerror=null;}"
        class:list={[
          'w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]',
          featured ? 'aspect-[16/10]' : 'aspect-[4/3]',
        ]}
      />
    </a>
    <div class="absolute bottom-0 left-0 z-10">
      <PostCategoryPill category={entry.data.category} variant="overlay" />
    </div>
  </div>
  <div class="post-card-body">
    <h2
      class:list={[
        'post-card-title font-heading text-brand-700 m-0 leading-snug',
        featured ? 'text-xl lg:text-2xl' : 'text-lg lg:text-xl',
      ]}
    >
      <a href={href} class="text-inherit no-underline hover:underline">
        {entry.data.title}
      </a>
    </h2>
    <p class="post-card-excerpt">{entry.data.description}</p>
    <footer class="post-card-meta flex flex-wrap items-baseline justify-between gap-2">
      <time datetime={entry.data.publishDate.toISOString()}>
        {articleDateFormat.format(entry.data.publishDate)}
      </time>
      <span>{articleAuthor(entry)}</span>
    </footer>
  </div>
</article>
