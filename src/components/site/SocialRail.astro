---
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';

const shareUrl = Astro.url.href;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
---

<aside class="social-rail fixed bottom-0 left-0 z-30 hidden md:block" aria-label="Social sharing">
  <ul class="m-0 flex list-none flex-col p-0">
    {
      site.social.facebook && (
        <li>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="social-rail-link"
            aria-label="Visit us on Facebook"
          >
            <Icon name="lucide:facebook" class="social-rail-icon" aria-hidden="true" />
          </a>
        </li>
      )
    }
    <li>
      <a
        href={facebookShare}
        target="_blank"
        rel="noopener noreferrer"
        class="social-rail-link"
        aria-label="Share this page on Facebook"
      >
        <Icon name="lucide:share-2" class="social-rail-icon" aria-hidden="true" />
      </a>
    </li>
  </ul>
</aside>

<style>
  .social-rail-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0 50% 50% 0;
    background-color: rgb(2, 32, 51);
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .social-rail-link:hover,
  .social-rail-link:focus-visible {
    background-color: #fff;
    color: rgb(2, 32, 51);
  }

  .social-rail-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
