---
import SiteContainer from '../SiteContainer.astro';
import PublicPicture from '../PublicPicture.astro';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../../../lib/publicImages';
---

<section class="hero">
  <SiteContainer>
    <div class="hero-image">
      <PublicPicture
        src="/images/banner01.webp"
        alt="Child holding a colorful umbrella outdoors"
        widths={[...HERO_IMAGE_WIDTHS]}
        sizes={HERO_IMAGE_SIZES}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={1500}
        height={475}
        class="hero-image__photo"
      />
      <div class="hero-content">
        <h2>&ldquo;I know my parents only want the best for me.&rdquo;</h2>
      </div>
    </div>
  </SiteContainer>
</section>

<style is:global>
  .hero {
    display: flex;
    justify-content: center;
  }

  .hero .contained {
    position: relative;
    height: 475px;
    padding: 0;
  }

  .hero .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero .hero-image__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 50%;
  }

  .hero .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .hero .hero-content h2 {
    color: #fff;
    width: 320px;
    margin: 0 auto;
    text-align: center;
    font-size: 2em;
    text-shadow: 2px 2px #000;
    font-family: 'Open Sans', sans-serif;
    font-weight: 400;
    line-height: 1.2;
  }

  @media (min-width: 575px) {
    .hero .hero-content h2 {
      width: 400px;
      margin-left: 50px;
      margin-right: auto;
      font-size: 2.75em;
      text-align: left;
    }
  }

  @media (min-width: 800px) {
    .hero .hero-content {
      background-color: transparent;
    }
  }
</style>
