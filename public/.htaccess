# ---------------------------------------------------------------------------
# Astro static build on cPanel / Apache.
# Assumes astro.config.mjs: trailingSlash 'always' + build.format 'directory'.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# Astro emits the 404 as a flat /404.html even with build.format 'directory'.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force non-www. Swap the two lines below to prefer www instead.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Add the trailing slash in one hop so mod_dir doesn't chain a second redirect.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.+)/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # ----- BEGIN ARTICLE CANONICAL SLUG 301 REDIRECTS (from src/data/article-redirects.ts) -----
  # Regenerate: node scripts/generate-article-htaccess.mjs
  RewriteRule ^article/cal-exit---a-move-away-trend-in-california/?$ /article/cal-exit-a-move-away-trend-in-california/ [R=301,L]
  RewriteRule ^article/covid-19---here-for-the-long-haul/?$ /article/covid-19-here-for-the-long-haul/ [R=301,L]
  RewriteRule ^article/my-ex-is-a-narcissist--honey-they-all-are/?$ /article/my-ex-is-a-narcissist-honey-they-all-are/ [R=301,L]
  RewriteRule ^article/co-parenting-covid-19-and-halloween-/?$ /article/co-parenting-covid-19-and-halloween/ [R=301,L]
  RewriteRule ^article/the-honor-and-responsibility-of-mentoring-female-attorneys-/?$ /article/the-honor-and-responsibility-of-mentoring-female-attorneys/ [R=301,L]
  RewriteRule ^article/co-parenting-the-journey-you-never-wanted-to-take-and-how-to-make-it-right-for-the-kids/?$ /article/co-parenting-the-journey-you-never-wanted-to-take/ [R=301,L]
  RewriteRule ^article/helping-your-kids-heal-after-a-divorce/?$ /article/helping-your-kids-heal-after-a-divorce-part-two/ [R=301,L]
  RewriteRule ^article/high-cost-of-the-unknown-with-divorce/?$ /article/high-cost-of-the-unknown-in-a-divorce/ [R=301,L]
  RewriteRule ^article/you-marriage-ended-but-your-parenting-job-has-not/?$ /article/your-marriage-ended-but-your-parenting-job-has-not/ [R=301,L]
  # ----- END ARTICLE CANONICAL SLUG 301 REDIRECTS -----

  # ----- BEGIN LEGACY default.aspx 301 REDIRECTS (from legacy-seo.json) -----
  # Regenerate: node scripts/generate-legacy-path-htaccess.mjs
  RewriteRule ^contact/default\.aspx/?$ /contact/ [R=301,L]
  RewriteRule ^default\.aspx/?$ // [R=301,L]
  RewriteRule ^endorsements/default\.aspx/?$ /endorsements/ [R=301,L]
  RewriteRule ^news/default\.aspx/?$ /news/ [R=301,L]
  RewriteRule ^our-lawyers/amy-hilton/default\.aspx/?$ /our-lawyers/amy-hilton/ [R=301,L]
  RewriteRule ^our-lawyers/hemma-gill/default\.aspx/?$ /our-lawyers/hemma-gill/ [R=301,L]
  RewriteRule ^services/child-and-spousal-support/default\.aspx/?$ /services/child-and-spousal-support/ [R=301,L]
  RewriteRule ^services/child-custody/default\.aspx/?$ /services/child-custody/ [R=301,L]
  RewriteRule ^services/domestic-violence/default\.aspx/?$ /services/domestic-violence/ [R=301,L]
  RewriteRule ^services/enforcement/default\.aspx/?$ /services/enforcement/ [R=301,L]
  RewriteRule ^services/modifications/default\.aspx/?$ /services/modifications/ [R=301,L]
  RewriteRule ^services/property-division/default\.aspx/?$ /services/property-division/ [R=301,L]
  RewriteRule ^services/retirement/default\.aspx/?$ /services/retirement/ [R=301,L]
  RewriteRule ^services/set-asides/default\.aspx/?$ /services/set-asides/ [R=301,L]
  # ----- END LEGACY default.aspx 301 REDIRECTS -----

</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Astro fingerprints hashed assets, so they can be cached hard.
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must revalidate or a deploy won't be visible.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
